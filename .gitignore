# 虚拟环境
.venv/
venv/
env/

# 本地数据文件（所有数据目录、缓存、日志等）
data/
config/profiles/
config/global_fund_sector_mapping.json
config/global_sector_limits.json

# 但保留以下代码文件（如果有需要保留的文件）
# 注意：data/.gitkeep 如果存在，需要单独保留，可以用 ! 规则
!data/.gitkeep

# Streamlit 缓存
.streamlit/
.cache/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 环境变量
.env
secrets.toml

# 日志及临时文件
*.tmp
*.log